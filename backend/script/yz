#!/usr/bin/env bash
# yz — yangzhou CLI 包装脚本:jar 不在则自动构建
# 用法: script/yz [命令...]  (等价 java -jar backend/cli/build/libs/yz-*.jar [命令...])
set -e
cd "$(dirname "$0")/.."

JAR=$(ls backend/cli/build/libs/yz-*.jar 2>/dev/null | head -1)
if [ -z "$JAR" ]; then
  echo "首次运行:构建 CLI(fat-jar)…"
  (cd backend && gradle :cli:jar --console=plain)
  JAR=$(ls backend/cli/build/libs/yz-*.jar | head -1)
fi
exec java -jar "$JAR" "$@"
